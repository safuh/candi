---
const heading = '<C_and_I />';
---

<header class="site-nav">
	<a class="brand" href="/" aria-label="Codes and I home">
		<code>{heading}</code>
	</a>

	<nav aria-label="Primary navigation">
		<a href="/">Home</a>
		<a href="/services">Expertise</a>
		<a href="/blogs">Notes</a>
	</nav>
</header>

<style>
	.site-nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 30px;
		padding: 22px 0;
		border-bottom: 1px solid rgba(38, 54, 83, .65);
	}
	.brand { color: #dce6f8; font-size: 1.05rem; font-weight: 700; }
	.brand code { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; }
	nav { display: flex; align-items: center; gap: 28px; }
	nav a { color: #7f8ea7; font-size: .82rem; font-weight: 700; }
	nav a:hover, .brand:hover { color: #8eb5ff; }
	@media (max-width: 600px) {
		.site-nav { padding: 17px 0; }
		nav { gap: 15px; }
		nav a { font-size: .74rem; }
	}
</style>
